# Supabase session pooler URIs (Project -> Connect -> Session pooler). Never commit real values.
SUPABASE_DEV_SESSION_POOLER=
SUPABASE_PROD_SESSION_POOLER=

# Web app (apps/web/.env.local for local dev; Vercel env vars for prod)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local only: lets /auth/dev-login skip email. Never set this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=
